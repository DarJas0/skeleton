{% extends 'base.html.twig' %}

{% import 'macros/ui.html.twig' as ui %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    {# Navbar #}
    {{ ui.render_component('Navbar', {
        'logo': 'Admin Dashboard',
        'links': [
            {'label': 'Overview', 'href': '#', 'active': true},
            {'label': 'Users', 'href': '#'},
            {'label': 'Settings', 'href': '#'}
        ],
        'secondaryCta': {'label': 'Logout', 'href': '#', 'variant': 'ghost', 'accent': 'neutral'}
    }) }}

    <div style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
        
        {# Alert #}
        <div id="alert-container" style="margin-bottom: 2rem;">
            {{ ui.render_component('Alert', {
                'title': 'System Update',
                'message': 'The system has been successfully updated to version 2.0. New features are now available.',
                'variant': 'success'
            }) }}
        </div>

        {# Page Header #}
        <div style="margin-bottom: 2rem;">
            <h1 style="font-size: 1.875rem; font-weight: bold; color: #111827;">Dashboard Overview</h1>
            <p style="color: #6b7280;">Welcome back, here is what's happening with your projects today.</p>
        </div>

        {# Cards Grid #}
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
            
            {# Card 1: Project Status #}
            {{ ui.render_component('Card', {
                'title': 'Active Projects',
                'content': '
                    <div style="margin-bottom: 1rem;">
                        <p style="color: #4b5563; margin-bottom: 1rem;">You have <strong>12</strong> active projects running. 3 are nearing their deadline.</p>
                        ' ~ ui.render_component('Badge', {'label': 'On Track', 'accent': 'success'}) ~ '
                    </div>
                    ' ~ ui.render_component('Button', {'label': 'View Projects', 'accent': 'primary', 'fullWidth': true}) ~ '
                '
            }) }}

            {# Card 2: Pending Tasks #}
            {{ ui.render_component('Card', {
                'title': 'Pending Tasks',
                'content': '
                    <div style="margin-bottom: 1rem;">
                        <p style="color: #4b5563; margin-bottom: 1rem;">There are <strong>5</strong> tasks waiting for your review in the queue.</p>
                        ' ~ ui.render_component('Badge', {'label': 'Action Required', 'accent': 'warning'}) ~ '
                    </div>
                    ' ~ ui.render_component('Button', {'label': 'Review Tasks', 'variant': 'outline', 'accent': 'neutral', 'fullWidth': true}) ~ '
                '
            }) }}

            {# Card 3: System Health #}
            {{ ui.render_component('Card', {
                'title': 'System Health',
                'content': '
                    <div style="margin-bottom: 1rem;">
                        <p style="color: #4b5563; margin-bottom: 1rem;">All systems are operational. Server load is currently at 24%.</p>
                        ' ~ ui.render_component('Badge', {'label': 'Stable', 'accent': 'info'}) ~ '
                    </div>
                    ' ~ ui.render_component('Button', {'label': 'System Details', 'variant': 'ghost', 'accent': 'error', 'fullWidth': true}) ~ '
                '
            }) }}

        </div>

        <div style="margin-top: 2rem; text-align: center;">
            <button id="simulate-loading" style="padding: 0.5rem 1rem; background-color: #f3f4f6; border: 1px solid #d1d5db; border-radius: 0.375rem; cursor: pointer;">Simulate Incoming Alert</button>
        </div>

    </div>

    <script>
        document.getElementById('simulate-loading').addEventListener('click', function() {
            const container = document.getElementById('alert-container');
            const newAlert = document.createElement('div');
            
            const props = {
                title: 'New Notification',
                message: 'This alert was added dynamically via DOM manipulation at ' + new Date().toLocaleTimeString(),
                variant: 'info'
            };

            newAlert.dataset.reactComponent = 'Alert';
            newAlert.dataset.props = JSON.stringify(props);
            newAlert.style.marginTop = '1rem';

            container.appendChild(newAlert);
        });
    </script>
{% endblock %}
